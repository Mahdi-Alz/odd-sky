{
  "name": "odd-sky",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @odd-sky/web",
    "build": "npm run build -w @odd-sky/web",
    "preview": "npm run preview -w @odd-sky/web",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p apps/web/jsconfig.json && tsc -p packages/core/jsconfig.json && tsc -p apps/api/jsconfig.json",
    "migrate": "npm run migrate -w @odd-sky/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
